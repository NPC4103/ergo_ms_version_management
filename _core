[32m+[m[32m./linux/version_manager.sh create --name "Мой репозиторий" --description "Описание"[m
[32m+[m[32m./linux/version_manager.sh download --source /path/to/repo.zip --uuid <uuid>[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### Windows[m
[32m+[m
[32m+[m[32m```powershell[m
[32m+[m[32m# Использование[m
[32m+[m[32mpwsh -File windows/version_manager.ps1 create --name "Мой репозиторий" --description "Описание"[m
[32m+[m[32mpwsh -File windows/version_manager.ps1 download --source "C:\path\to\repo.zip" --uuid <uuid>[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m## Параметры команд[m
[32m+[m
[32m+[m[32m### create[m
[32m+[m[32m- `--name <имя>` — название репозитория (если не указано, запрашивается интерактивно)[m
[32m+[m[32m- `--description <текст>` — описание репозитория (если не указано, запрашивается интерактивно)[m
[32m+[m[32m- `--root <путь>` — указать корень проекта вручную (по умолчанию определяется автоматически)[m
[32m+[m
[32m+[m[32m### download[m
[32m+[m[32m- `--source <zip|dir>` — путь к zip-архиву или папке с репозиторием (обязательный)[m
[32m+[m[32m- `--uuid <uuid>` — UUID для репозитория (если не указан, генерируется автоматически)[m
[32m+[m[32m- `--name <имя>` — название репозитория (опционально, сохраняется в manifest.json)[m
[32m+[m[32m- `--root <путь>` — указать корень проекта вручную (по умолчанию определяется автоматически)[m
[32m+[m
[32m+[m[32m## Структура репозитория[m
[32m+[m
[32m+[m[32mПосле создания или скачивания репозитория в `media/version_management/<UUID>/` будет следующая структура:[m
[32m+[m
[32m+[m[32m```[m
[32m+[m[32m<UUID>/[m
[32m+[m[32m  ├── api/[m
[32m+[m[32m  ├── client/[m
[32m+[m[32m  └── manifest.json[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mФайл `manifest.json` содержит метаданные:[m
[32m+[m[32m```json[m
[32m+[m[32m{[m
[32m+[m[32m  "uuid": "<uuid>",[m
[32m+[m[32m  "name": "Название репозитория",[m
[32m+[m[32m  "description": "Описание"[m
[32m+[m[32m}[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m## Примечания[m
[32m+[m
[32m+[m[32m- Утилита автоматически определяет корень проекта, ища папку `modules/version_management` вверх по дереву каталогов[m
[32m+[m[32m- Все репозитории хранятся в `media/version_management/<UUID>/`[m
[32m+[m[32m- Пока утилита работает без бэкенда, создавая только локальную структуру[m
[32m+[m
