[32m+[m[32m# Инструкция по использованию API функций[m
[32m+[m
[32m+[m[32m## ✅ Этап 1 выполнен[m
[32m+[m
[32m+[m[32mБазовые функции для работы с API уже реализованы и готовы к использованию.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Доступные функции[m
[32m+[m
[32m+[m[32m### Linux (bash)[m
[32m+[m
[32m+[m[32m#### `get_api_base_url()`[m
[32m+[m[32mПолучает базовый URL API с учетом приоритетов:[m
[32m+[m[32m1. Переменная окружения `API_BASE_URL`[m
[32m+[m[32m2. Конфиг файл `~/.ergovcs/config` (строка `api_base_url=...`)[m
[32m+[m[32m3. Переменные `API_HOST` и `API_PORT`[m
[32m+[m[32m4. Значение по умолчанию: `http://localhost:8000/api/version_management`[m
[32m+[m
[32m+[m[32m**Пример:**[m
[32m+[m[32m```bash[m
[32m+[m[32mbase_url=$(get_api_base_url)[m
[32m+[m[32mecho "$base_url"  # http://localhost:8000/api/version_management[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m#### `api_request()`[m
[32m+[m[32mВыполняет HTTP запрос к API.[m
[32m+[m
[32m+[m[32m**Параметры:**[m
[32m+[m[32m- `$1` - метод (GET, POST, PUT, DELETE)[m
[32m+[m[32m- `$2` - endpoint (относительный путь, например `/repositories/list/`)[m
[32m+[m[32m- `$3` - тело запроса (опционально, для POST/PUT, JSON строка)[m
[32m+[m[32m- `$4` - заголовки (опционально, формат: `"Header1: Value1,Header2: Value2"`)[m
[32m+[m
[32m+[m[32m**Возвращает:**[m
[32m+[m[32m- JSON ответ от API (через stdout)[m
[32m+[m[32m- В случае ошибки: выводит сообщение в stderr и возвращает код ошибки[m
[32m+[m
[32m+[m[32m**Примеры:**[m
[32m+[m[32m```bash[m
[32m+[m[32m# GET запрос[m
[32m+[m[32mresponse=$(api_request "GET" "/repositories/list/")[m
[32m+[m[32mecho "$response"[m
[32m+[m
[32m+[m[32m# POST запрос с телом[m
[32m+[m[32mbody='{"name": "My Repository"}'[m
[32m+[m[32mresponse=$(api_request "POST" "/repositories/create/" "$body")[m
[32m+[m[32mecho "$response"[m
[32m+[m
[32m+[m[32m# POST запрос с кастомными заголовками[m
[32m+[m[32mheaders="Authorization: Bearer token123"[m
[32m+[m[32mresponse=$(api_request "POST" "/repositories/create/" "$body" "$headers")[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m**Обработка ошибок:**[m
[32m+[m[32m```bash[m
[32m+[m[32mif ! response=$(api_request "GET" "/repositories/list/"); then[m
[32m+[m[32m  echo "Ошибка при выполнении запроса"[m
[32m+[m[32m  exit 1[m
[32m+[m[32mfi[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m### Windows (PowerShell)[m
[32m+[m
[32m+[m[32m#### `Get-ApiBaseUrl`[m
[32m+[m[32mПолучает базовый URL API с учетом приоритетов:[m
[32m+[m[32m1. Переменная окружения `$env:API_BASE_URL`[m
[32m+[m[32m2. Конфиг файл `%USERPROFILE%\.ergovcs\config` (строка `api_base_url=...`)[m
[32m+[m[32m3. Переменные `$env:API_HOST` и `$env:API_PORT`[m
[32m+[m[32m4. Значение по умолчанию: `http://localhost:8000/api/version_management`[m
[32m+[m
[32m+[m[32m**Пример:**[m
[32m+[m[32m```powershell[m
[32m+[m[32m$baseUrl = Get-ApiBaseUrl[m
[32m+[m[32mWrite-Host $baseUrl  # http://localhost:8000/api/version_management[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m#### `Invoke-ApiRequest`[m
[32m+[m[32mВыполняет HTTP запрос к API.[m
[32m+[m
[32m+[m[32m**Параметры:**[m
[32m+[m[32m- `-Method` - метод (GET, POST, PUT, DELETE, PATCH) [обязательный][m
[32m+[m[32m- `-Endpoint` - endpoint (относительный путь) [обязательный][m
[32m+[m[32m- `-Body` - тело запроса (опционально, для POST/PUT, JSON строка)[m
[32m+[m[32m- `-Headers` - заголовки (опционально, hashtable)[m
[32m+[m
[32m+[m[32m**Возвращает:**[m
[32m+[m[32m- JSON строка с ответом от API[m
[32m+[m[32m- `$null` в случае ошибки (сообщение об ошибке выводится в консоль)[m
[32m+[m
[32m+[m[32m**Примеры:**[m
[32m+[m[32m```powershell[m
[32m+[m[32m# GET запрос[m
[32m+[m[32m$response = Invoke-ApiRequest -Method "GET" -Endpoint "/repositories/list/"[m
[32m+[m[32mWrite-Host $response[m
[32m+[m
[32m+[m[32m# POST запрос с телом[m
[32m+[m[32m$body = '{"name": "My Repository"}'[m
[32m+[m[32m$response = Invoke-ApiRequest -Method "POST" -Endpoint "/repositories/create/" -Body $body[m
[32m+[m[32mWrite-Host $response[m
[32m+[m
[32m+[m[32m# POST запрос с кастомными заголовками[m
[32m+[m[32m$headers = @{[m
[32m+[m[32m    "Authorization" = "Bearer token123"[m
[32m+[m[32m}[m
[32m+[m[32m$response = Invoke-ApiRequest -Method "POST" -Endpoint "/repositories/create/" -Body $body -Headers $headers[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m**Обработка ошибок:**[m
[32m+[m[32m```powershell[m
[32m+[m[32m$response = Invoke-ApiRequest -Method "GET" -Endpoint "/repositories/list/"[m
[32m+[m[32mif (-not $response) {[m
[32m+[m[32m    Write-Host "Ошибка при выполнении запроса"[m
[32m+[m[32m    exit 1[m
[32m+[m[32m}[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Конфигурация[m
[32m+[m
[32m+[m[32m### Создание конфиг файла[m
[32m+[m
[32m+[m[32m**Linux:**[m
[32m+[m[32m```bash[m
[32m+[m[32mmkdir -p ~/.ergovcs[m
[32m+[m[32mcat > ~/.ergovcs/config <<EOF[m
[32m+[m[32mapi_base_url=http://localhost:8000/api/version_management[m
[32m+[m[32mEOF[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m**Windows:**[m
[32m+[m[32m```powershell[m
[32m+[m[32mNew-Item -ItemType Directory -Force -Path "$env:USERPROFILE\.ergovcs" | Out-Null[m
[32m+[m[32mSet-Content -Path "$env:USERPROFILE\.ergovcs\config" -Value "api_base_url=http://localhost:8000/api/version_management"[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### Использование переменных окружения[m
[32m+[m
[32m+[m[32m**Linux:**[m
[32m+[m[32m```bash[m
[32m+[m[32mexport API_BASE_URL="http://localhost:8000/api/version_management"[m
[32m+[m[32m# или[m
[32m+[m[32mexport API_HOST="localhost"[m
[32m+[m[32mexport API_PORT="8000"[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m**Windows:**[m
[32m+[m[32m```powershell[m
[32m+[m[32m$env:API_BASE_URL = "http://localhost:8000/api/version_management"[m
[32m+[m[32m# или[m
[32m+[m[32m$env:API_HOST = "localhost"[m
[32m+[m[32m$env:API_PORT = "8000"[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Примеры использования в командах[m
[32m+[m
[32m+[m[32m### Пример для `cmd_clone()` (Linux)[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32mcmd_clone() {[m
[32m+[m[32m  local uuid="$1"[m
[32m+[m[41m  [m
[32m+[m[32m  # Вызов API для клонирования[m
[32m+[m[32m  local response[m
[32m+[m[32m  response="$(api_request "GET" "/repositories/$uuid/clone/")"[m
[32m+[m[41m  [m
[32m+[m[32m  if [[ $? -ne 0 ]]; then[m
[32m+[m[32m    echo "[ERROR] Не удалось клонировать репозиторий" >&2[m
[32m+[m[32m    return 1[m
[32m+[m[32m  fi[m
[32m+[m[41m  [m
[32m+[m[32m  # Парсинг ответа (пример)[m
[32m+[m[32m  local repo_path[m
[32m+[m[32m  repo_path="$(echo "$response" | grep -o '"path":"[^"]*"' | cut -d'"' -f4)"[m
[32m+[m[41m  [m
[32m+[m[32m  echo "[OK] Репозиторий клонирован: $repo_path"[m
[32m+[m[32m}[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### Пример для `Invoke-Clone` (Windows)[m
[32m+[m
[32m+[m[32m```powershell[m
[32m+[m[32mfunction Invoke-Clone {[m
[32m+[m[32m  param([string[]]$Args)[m
[32m+[m[41m  [m
[32m+[m[32m  $uuid = $Args[0][m
[32m+[m[41m  [m
[32m+[m[32m  # Вызов API для клонирования[m
[32m+[m[32m  $response = Invoke-ApiRequest -Method "GET" -Endpoint "/repositories/$uuid/clone/"[m
[32m+[m[41m  [m
[32m+[m[32m  if (-not $response) {[m
[32m+[m[32m    Write-Host "[ERROR] Не удалось клонировать репозиторий" -ForegroundColor Red[m
[32m+[m[32m    exit 1[m
[32m+[m[32m  }[m
[32m+[m[41m  [m
[32m+[m[32m  # Парсинг ответа (пример)[m
[32m+[m[32m  $responseObj = $response | ConvertFrom-Json[m
[32m+[m[32m  $repoPath = $responseObj.path[m
[32m+[m[41m  [m
[32m+[m[32m  Write-Host "[OK] Репозиторий клонирован: $repoPath" -ForegroundColor Green[m
[32m+[m[32m}[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Формат ответов API[m
[32m+[m
[32m+[m[32mВсе функции автоматически обрабатывают JSON ответы. Типичный формат ответа:[m
[32m+[m
[32m+[m[32m**Успешный ответ:**[m
[32m+[m[32m```json[m
